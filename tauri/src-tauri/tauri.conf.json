{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CConnect",
  "version": "1.6.3",
  "identifier": "com.jahirtrap.cconnect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "CConnect",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' data: blob: http: https:",
        "object-src": "'self' data: blob:",
        "frame-src": "'self' data: blob: http: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: http: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "jahirtrap",
    "copyright": "© jahirtrap",
    "category": "DeveloperTool",
    "shortDescription": "Claude Code desde cualquier dispositivo",
    "longDescription": "Cliente de Claude Code con chat, archivos compartidos, terminal SSH y monitor del servidor.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/banner.bmp",
        "dialogImagePath": "installer/dialog.bmp"
      }
    },
    "android": {
      "versionCode": 41
    },
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}

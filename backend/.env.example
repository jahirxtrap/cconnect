# Local dev reads these from a .env file at the backend root (auto-loaded by core/config.py).

# Uvicorn bind port (uncommon by default to avoid clashes).
PORT=8723

# Where Claude Code stores its sessions. Defaults to ~/.claude/projects.
# CLAUDE_PROJECTS_DIR=

# Fallback cwd for chats started without picking a directory. Defaults to the
# parent of the backend folder (the repo root for in-tree deployments).
# DEFAULT_CWD=

# Default permission mode for new chat sessions:
# default | acceptEdits | plan | dontAsk | bypassPermissions | auto
DEFAULT_PERMISSION_MODE=bypassPermissions

# Default effort level (low | medium | high | xhigh | max).
DEFAULT_EFFORT=xhigh

# Default model id (opus | opus[1m] | sonnet | sonnet[1m] | haiku | default).
DEFAULT_MODEL=opus[1m]

# Pull the latest claude-agent-sdk on startup. Set to 0 for faster dev reloads.
AUTO_UPDATE_SDK=1

# Bearer token used only when the backend is exposed publicly (e.g. via
# `python run.py --expose tailscale`). Private runs (`python run.py`) ignore it
# completely and remain auth-less, regardless of what this value is.
# On the first `--expose` run, if this is empty or missing, run.py generates a
# token and writes it back here automatically.
# PUBLIC_ACCESS_TOKEN=

# Hostname your reverse proxy serves, used by `python run.py --expose caddy` to
# build the public URL and the QR. `--public-host` overrides it; with neither,
# run.py derives <user>-<public-ip>.sslip.io, which needs no DNS setup but only
# works on a machine with a public IP.
# PUBLIC_HOSTNAME=

# Key that unlocks the terminal, which gives a shell on this machine. run.py
# generates it on first start and writes it back here, then prints it on every
# start so you can enter it on a new device; `--terminal-key --rotate` replaces
# it. It is the only thing gating the terminal, and no endpoint ever returns it.
# TERMINAL_ACCESS_KEY=

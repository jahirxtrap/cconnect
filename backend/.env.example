# Optional settings, auto-loaded by core/config.py. A plain `cconnect` needs
# none of them. Drop the `.example` suffix on a copy of this file to use it: a
# checkout reads it from backend/, an installed command from its config folder.
# README.md has the full table with every variable and its default.

PORT=8723

# default | acceptEdits | plan | dontAsk | bypassPermissions | auto
DEFAULT_PERMISSION_MODE=bypassPermissions

# low | medium | high | xhigh | max
DEFAULT_EFFORT=xhigh

# opus | opus[1m] | sonnet | sonnet[1m] | haiku | default
DEFAULT_MODEL=opus[1m]

# Where Claude Code stores its sessions. Defaults to ~/.claude/projects.
# CLAUDE_PROJECTS_DIR=

# Everything the backend owns and would carry to another machine. Defaults to
# backend/data in a checkout and ~/.cconnect/data once installed.
# CCONNECT_DATA_DIR=

# What it can rebuild on its own, kept beside the data folder so a migration
# never drags it along. Defaults to backend/cache or ~/.cconnect/cache.
# CCONNECT_CACHE_DIR=

# The drop folder on its own. Point two backends at the same one and both
# serve the same files. Defaults to the shared folder inside the data.
# CCONNECT_SHARED_DIR=

# Fallback cwd for chats started without picking a directory. Defaults to the
# parent of the backend folder in a checkout, and to your home once installed.
# DEFAULT_CWD=

# Bearer token for public exposure, written back on the first `expose` run.
# Private runs ignore it and stay auth-less.
# PUBLIC_ACCESS_TOKEN=

# Hostname your reverse proxy serves, for `expose caddy`. Without it the
# command derives <user>-<public-ip>.sslip.io, which needs a public IP.
# PUBLIC_HOSTNAME=

# Key that unlocks the terminal, the ignored files and committing, written back
# on first start and printed on every start. It is the only gate.
# SECURITY_KEY=

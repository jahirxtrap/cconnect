{
  "defaults": {
    "form": "server",
    "packages": [],
    "distributions": [],
    "host": true,
    "port": null,
    "database_query": null,
    "databases": null,
    "home": null,
    "sqlglot": "",
    "connect_timeout": null,
    "connect_args": {},
    "read_only": [],
    "read_write": [],
    "timeout": null,
    "version": null,
    "table_filter": null,
    "primary_key": null,
    "columns": null,
    "binary": "X'{hex}'",
    "hidden_schemas": ["information_schema", "INFORMATION_SCHEMA"],
    "options": [],
    "extensions": [],
    "signature": null
  },
  "engines": [
    {
      "id": "sqlite",
      "label": "SQLite",
      "dialect": "sqlite",
      "form": "file",
      "sqlglot": "sqlite",
      "connect_timeout": "timeout",
      "connect_args": {"check_same_thread": false},
      "read_only": ["PRAGMA query_only = ON"],
      "read_write": ["PRAGMA query_only = OFF"],
      "hidden_schemas": [],
      "extensions": ["db", "sqlite", "sqlite3", "db3", "s3db", "sl3", "sqlitedb", "sdb", "gpkg", "mbtiles"],
      "signature": {"offset": 0, "text": "SQLite format 3"}
    },
    {
      "id": "postgresql",
      "label": "PostgreSQL",
      "dialect": "postgresql+psycopg",
      "packages": ["psycopg[binary]"],
      "distributions": ["psycopg", "psycopg-binary"],
      "port": 5432,
      "databases": "SELECT datname FROM pg_database WHERE NOT datistemplate AND datallowconn AND has_database_privilege(datname, 'CONNECT') ORDER BY datname",
      "home": "postgres",
      "sqlglot": "postgres",
      "connect_timeout": "connect_timeout",
      "read_only": ["SET TRANSACTION READ ONLY"],
      "timeout": "SET LOCAL statement_timeout = {milliseconds}",
      "binary": "decode('{hex}', 'hex')",
      "hidden_schemas": ["information_schema", "pg_catalog", "pg_toast"]
    },
    {
      "id": "mysql",
      "label": "MySQL",
      "dialect": "mysql+pymysql",
      "packages": ["pymysql"],
      "distributions": ["pymysql"],
      "port": 3306,
      "sqlglot": "mysql",
      "connect_timeout": "connect_timeout",
      "read_only": ["SET TRANSACTION READ ONLY"],
      "timeout": "SET SESSION max_execution_time = {milliseconds}",
      "hidden_schemas": ["information_schema", "mysql", "performance_schema", "sys"]
    },
    {
      "id": "mariadb",
      "extends": "mysql",
      "label": "MariaDB",
      "dialect": "mariadb+pymysql",
      "timeout": "SET SESSION max_statement_time = {seconds}"
    },
    {
      "id": "mssql",
      "label": "SQL Server",
      "dialect": "mssql+pymssql",
      "packages": ["pymssql"],
      "distributions": ["pymssql"],
      "port": 1433,
      "databases": "SELECT name FROM sys.databases WHERE HAS_DBACCESS(name) = 1 AND state = 0 ORDER BY name",
      "sqlglot": "tsql",
      "connect_timeout": "login_timeout",
      "binary": "0x{hex}",
      "hidden_schemas": ["INFORMATION_SCHEMA", "sys", "guest"]
    },
    {
      "id": "oracle",
      "label": "Oracle",
      "dialect": "oracle+oracledb",
      "packages": ["oracledb"],
      "distributions": ["oracledb"],
      "port": 1521,
      "database_query": "service_name",
      "sqlglot": "oracle",
      "connect_timeout": "tcp_connect_timeout",
      "read_only": ["SET TRANSACTION READ ONLY"],
      "binary": "HEXTORAW('{hex}')",
      "hidden_schemas": ["SYS", "SYSTEM", "XDB", "OUTLN", "DBSNMP", "APPQOSSYS", "AUDSYS", "GSMADMIN_INTERNAL", "OJVMSYS", "LBACSYS", "DVSYS", "WMSYS", "CTXSYS", "MDSYS", "ORDSYS", "OLAPSYS"]
    },
    {
      "id": "duckdb",
      "label": "DuckDB",
      "dialect": "duckdb",
      "form": "file",
      "packages": ["duckdb-engine"],
      "distributions": ["duckdb-engine", "duckdb"],
      "sqlglot": "duckdb",
      "version": "SELECT version()",
      "table_filter": "table_name = :name AND coalesce(:schema, current_database() || '.' || current_schema()) IN (database_name || '.' || schema_name, schema_name)",
      "primary_key": "SELECT constraint_column_names FROM duckdb_constraints() WHERE constraint_type = 'PRIMARY KEY' AND {table}",
      "columns": "SELECT column_name AS name, data_type AS declared, is_nullable AS nullable, column_default AS \"default\" FROM duckdb_columns() WHERE {table} ORDER BY column_index",
      "binary": "unhex('{hex}')",
      "hidden_schemas": ["information_schema", "pg_catalog", "system.information_schema", "system.main", "system.pg_catalog", "temp.information_schema", "temp.main", "temp.pg_catalog"],
      "extensions": ["duckdb", "ddb"],
      "signature": {"offset": 8, "text": "DUCK"}
    },
    {"id": "aurora_dsql", "extends": "postgresql", "label": "Amazon Aurora DSQL", "dialect": "auroradsql+psycopg", "packages": ["aurora-dsql-sqlalchemy", "psycopg[binary]"], "distributions": ["aurora-dsql-sqlalchemy", "psycopg"]},
    {"id": "athena", "label": "Amazon Athena", "dialect": "awsathena+rest", "packages": ["pyathena[sqlalchemy]"], "distributions": ["pyathena"], "port": 443, "sqlglot": "athena", "options": ["s3_staging_dir", "work_group"]},
    {"id": "dynamodb", "label": "Amazon DynamoDB", "dialect": "dynamodb", "packages": ["pydynamodb"], "distributions": ["pydynamodb"], "port": 443, "options": ["region_name"]},
    {"id": "redshift", "extends": "postgresql", "label": "Amazon Redshift", "home": "dev", "dialect": "redshift+psycopg2", "packages": ["sqlalchemy-redshift", "psycopg2-binary"], "distributions": ["sqlalchemy-redshift", "psycopg2-binary"], "port": 5439, "sqlglot": "redshift", "timeout": null},
    {"id": "drill", "label": "Apache Drill", "dialect": "drill+sadrill", "packages": ["sqlalchemy-drill"], "distributions": ["sqlalchemy-drill"], "port": 8047, "sqlglot": "drill"},
    {"id": "druid", "label": "Apache Druid", "dialect": "druid", "packages": ["pydruid[sqlalchemy]"], "distributions": ["pydruid"], "port": 8082, "sqlglot": "druid"},
    {"id": "hive", "label": "Apache Hive", "dialect": "hive", "packages": ["pyhive[hive_pure_sasl]"], "distributions": ["pyhive"], "port": 10000, "sqlglot": "hive"},
    {"id": "impala", "label": "Apache Impala", "dialect": "impala", "packages": ["impyla"], "distributions": ["impyla"], "port": 21050, "sqlglot": "hive"},
    {"id": "pinot", "label": "Apache Pinot", "dialect": "pinot", "packages": ["pinotdb"], "distributions": ["pinotdb"], "port": 8099},
    {"id": "clickhouse", "label": "ClickHouse", "dialect": "clickhousedb", "packages": ["clickhouse-connect"], "distributions": ["clickhouse-connect"], "port": 8123, "sqlglot": "clickhouse", "hidden_schemas": ["system", "information_schema", "INFORMATION_SCHEMA"]},
    {"id": "cockroachdb", "extends": "postgresql", "label": "CockroachDB", "home": "defaultdb", "port": 26257, "hidden_schemas": ["information_schema", "pg_catalog", "pg_extension", "crdb_internal"]},
    {"id": "crate", "label": "CrateDB", "dialect": "crate", "packages": ["sqlalchemy-cratedb"], "distributions": ["sqlalchemy-cratedb"], "port": 4200, "sqlglot": "postgres", "hidden_schemas": ["information_schema", "pg_catalog", "sys"]},
    {"id": "databend", "label": "Databend", "dialect": "databend", "packages": ["databend-sqlalchemy"], "distributions": ["databend-sqlalchemy"], "port": 8000, "sqlglot": "mysql", "hidden_schemas": ["information_schema", "system"]},
    {"id": "databricks", "label": "Databricks", "dialect": "databricks", "packages": ["databricks-sqlalchemy"], "distributions": ["databricks-sqlalchemy"], "port": 443, "sqlglot": "databricks", "options": ["http_path", "catalog", "schema"]},
    {"id": "denodo", "label": "Denodo", "dialect": "denodo", "packages": ["denodo-sqlalchemy"], "distributions": ["denodo-sqlalchemy"], "port": 9996, "sqlglot": "postgres"},
    {"id": "elasticsearch", "label": "Elasticsearch", "dialect": "elasticsearch+http", "packages": ["elasticsearch-dbapi"], "distributions": ["elasticsearch-dbapi"], "port": 9200},
    {"id": "exasol", "label": "Exasol", "dialect": "exa+websocket", "packages": ["sqlalchemy-exasol"], "distributions": ["sqlalchemy-exasol"], "port": 8563, "sqlglot": "exasol", "hidden_schemas": ["SYS", "EXA_STATISTICS"]},
    {"id": "firebird", "label": "Firebird", "dialect": "firebird+firebird", "packages": ["sqlalchemy-firebird"], "distributions": ["sqlalchemy-firebird"], "port": 3050},
    {"id": "firebolt", "label": "Firebolt", "dialect": "firebolt", "packages": ["firebolt-sqlalchemy"], "distributions": ["firebolt-sqlalchemy"], "options": ["account_name"]},
    {"id": "bigquery", "label": "Google BigQuery", "dialect": "bigquery", "packages": ["sqlalchemy-bigquery"], "distributions": ["sqlalchemy-bigquery"], "sqlglot": "bigquery", "options": ["credentials_path", "location"]},
    {"id": "spanner", "label": "Google Cloud Spanner", "dialect": "spanner+spanner", "packages": ["sqlalchemy-spanner"], "distributions": ["sqlalchemy-spanner"], "host": false},
    {"id": "gsheets", "label": "Google Sheets", "dialect": "gsheets", "packages": ["shillelagh[gsheetsapi]"], "distributions": ["shillelagh"], "host": false, "options": ["service_account_file", "subject"]},
    {"id": "db2", "label": "IBM Db2", "dialect": "db2+ibm_db", "packages": ["ibm-db-sa", "ibm_db"], "distributions": ["ibm-db-sa", "ibm_db"], "port": 50000, "hidden_schemas": ["SYSCAT", "SYSIBM", "SYSIBMADM", "SYSSTAT", "SYSTOOLS", "SYSPROC", "SYSFUN", "NULLID", "SQLJ"]},
    {"id": "iris", "label": "InterSystems IRIS", "dialect": "iris", "packages": ["sqlalchemy-iris"], "distributions": ["sqlalchemy-iris"], "port": 1972},
    {"id": "libsql", "label": "libSQL / Turso", "dialect": "sqlite+libsql", "packages": ["sqlalchemy-libsql"], "distributions": ["sqlalchemy-libsql"], "sqlglot": "sqlite", "hidden_schemas": [], "options": ["authToken", "secure"]},
    {"id": "materialize", "extends": "postgresql", "label": "Materialize", "home": "materialize", "port": 6875, "sqlglot": "materialize", "read_only": [], "timeout": null, "hidden_schemas": ["information_schema", "pg_catalog", "mz_catalog", "mz_internal", "mz_introspection", "mz_unsafe"]},
    {"id": "mimer", "label": "Mimer SQL", "dialect": "mimer", "packages": ["sqlalchemy-mimer"], "distributions": ["sqlalchemy-mimer"], "port": 1360},
    {"id": "monetdb", "label": "MonetDB", "dialect": "monetdb", "packages": ["sqlalchemy-monetdb"], "distributions": ["sqlalchemy-monetdb"], "port": 50000, "hidden_schemas": ["sys", "tmp", "json", "profiler", "logging", "information_schema"]},
    {"id": "mongodb", "label": "MongoDB", "dialect": "mongodb", "packages": ["pymongosql"], "distributions": ["pymongosql"], "port": 27017},
    {"id": "oceanbase", "extends": "mysql", "label": "OceanBase", "port": 2881, "timeout": null, "hidden_schemas": ["information_schema", "mysql", "oceanbase", "LBACSYS", "ORAAUDITOR"]},
    {"id": "questdb", "extends": "postgresql", "label": "QuestDB", "home": "qdb", "port": 8812, "read_only": [], "timeout": null},
    {"id": "risingwave", "extends": "postgresql", "label": "RisingWave", "home": "dev", "port": 4566, "sqlglot": "risingwave", "read_only": [], "timeout": null, "hidden_schemas": ["information_schema", "pg_catalog", "rw_catalog"]},
    {"id": "hana", "label": "SAP HANA", "dialect": "hana+hdbcli", "packages": ["sqlalchemy-hana"], "distributions": ["sqlalchemy-hana", "hdbcli"], "port": 30015, "hidden_schemas": ["SYS", "_SYS_BIC", "_SYS_BI", "_SYS_REPO", "_SYS_STATISTICS", "_SYS_XS"]},
    {"id": "sybase", "label": "SAP ASE (Sybase)", "dialect": "sybase+pyodbc", "packages": ["sqlalchemy-sybase", "pyodbc"], "distributions": ["sqlalchemy-sybase", "pyodbc"], "port": 5000, "sqlglot": "tsql"},
    {"id": "singlestore", "extends": "mysql", "label": "SingleStore", "dialect": "singlestoredb", "packages": ["sqlalchemy-singlestoredb"], "distributions": ["sqlalchemy-singlestoredb", "singlestoredb"], "connect_timeout": null, "read_only": [], "timeout": null, "hidden_schemas": ["information_schema", "cluster", "memsql"]},
    {"id": "snowflake", "label": "Snowflake", "dialect": "snowflake", "packages": ["snowflake-sqlalchemy"], "distributions": ["snowflake-sqlalchemy", "snowflake-connector-python"], "sqlglot": "snowflake", "options": ["warehouse", "role"]},
    {"id": "starrocks", "extends": "mysql", "label": "StarRocks", "dialect": "starrocks", "packages": ["starrocks"], "distributions": ["starrocks"], "port": 9030, "sqlglot": "starrocks", "read_only": [], "timeout": null, "hidden_schemas": ["information_schema", "_statistics_", "sys"]},
    {"id": "doris", "extends": "mysql", "label": "Apache Doris", "dialect": "doris", "packages": ["pydoris"], "distributions": ["pydoris"], "port": 9030, "sqlglot": "doris", "read_only": [], "timeout": null, "hidden_schemas": ["information_schema", "__internal_schema", "mysql"]},
    {"id": "teradata", "label": "Teradata Vantage", "dialect": "teradatasql", "packages": ["teradatasqlalchemy"], "distributions": ["teradatasqlalchemy", "teradatasql"], "port": 1025, "sqlglot": "teradata", "hidden_schemas": ["DBC", "SYSLIB", "SYSUDTLIB", "SystemFe", "TD_SYSFNLIB", "TDQCD", "TDStats", "SYSSPATIAL", "SYSBAR", "Sys_Calendar"]},
    {"id": "tidb", "extends": "mysql", "label": "TiDB", "port": 4000, "hidden_schemas": ["information_schema", "mysql", "performance_schema", "metrics_schema", "sys"]},
    {"id": "trino", "label": "Trino", "dialect": "trino", "packages": ["trino[sqlalchemy]"], "distributions": ["trino"], "port": 8080, "sqlglot": "trino"},
    {"id": "presto", "label": "Presto", "dialect": "presto", "packages": ["pyhive[presto]"], "distributions": ["pyhive"], "port": 8080, "sqlglot": "presto"},
    {"id": "ydb", "label": "YDB", "dialect": "ydb", "packages": ["ydb-sqlalchemy"], "distributions": ["ydb-sqlalchemy", "ydb"], "port": 2136},
    {"id": "yugabytedb", "extends": "postgresql", "label": "YugabyteDB", "home": "yugabyte", "port": 5433},
    {"id": "custom", "label": null, "dialect": null, "form": "url", "host": false}
  ]
}

{
  "schema": 1,
  "extension": ".ccpack",
  "mime": "application/zip",
  "manifest": "pack.json",
  "themeKinds": ["light", "dark"],
  "colors": [
    "background",
    "on-background",
    "surface",
    "surface-variant",
    "surface-nested",
    "float",
    "on-surface-variant",
    "faint",
    "hover",
    "shadow",
    "shadow-soft",
    "outline",
    "outline-variant",
    "error",
    "on-accent",
    "scrollbar",
    "scrollbar-hover",
    "red",
    "red-bg",
    "green",
    "green-bg",
    "blue",
    "blue-bg",
    "yellow",
    "orange",
    "cyan",
    "purple",
    "gray"
  ],
  "derived": {
    "red-bg": { "from": "red", "alpha": 0.15 },
    "green-bg": { "from": "green", "alpha": 0.15 },
    "blue-bg": { "from": "blue", "alpha": 0.1 },
    "hover": { "from": "on-background", "alpha": 0.05 },
    "scrollbar": { "from": "on-background", "alpha": 0.2 },
    "scrollbar-hover": { "from": "on-background", "alpha": 0.35 }
  },
  "terminal": [
    "background",
    "foreground",
    "black",
    "red",
    "green",
    "yellow",
    "blue",
    "magenta",
    "cyan",
    "white",
    "bright-black",
    "bright-red",
    "bright-green",
    "bright-yellow",
    "bright-blue",
    "bright-magenta",
    "bright-cyan",
    "bright-white"
  ],
  "backgroundEffects": {
    "opacity": { "min": 0, "max": 100 },
    "brightness": { "min": 0, "max": 180 },
    "blur": { "min": 0, "max": 20 },
    "saturation": { "min": 0, "max": 200 },
    "x": { "min": 0, "max": 100 },
    "y": { "min": 0, "max": 100 }
  },
  "backgroundFits": ["cover", "contain"],
  "fontKinds": ["text", "mono", "symbols", "emoji"],
  "fontFormats": ["woff2", "woff", "ttf", "otf"],
  "imageFormats": ["png", "jpg", "jpeg", "webp", "gif", "avif", "svg"],
  "maxFileBytes": 10485760,
  "maxPackBytes": 52428800
}

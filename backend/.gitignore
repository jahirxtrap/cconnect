# SQLite store: backend-owned settings (CLI source, model/effort/permission, ...)
cconnect.db
cconnect.db-wal
cconnect.db-shm

# Pending conversation-rewind anchors (runtime state)
rewind_pending.json

# Last task list per session, replayed on resume (runtime state)
session_todos.json

# Server log for the monitor screen (one per run)
logs/

# Restart request flag (runtime state)
.restart

# PID and --expose provider of a backend started with --detach
.detached.pid
.detached.provider

# Stashed definitions of disabled MCP servers
mcp_disabled.json

# Last known good network configuration (runtime state)
network_state.json

# Context window probed per model, keyed by CLI version (runtime cache)
context_windows.json

# Per-account Claude config dirs (credentials, linked history)
accounts/

# User custom prompt
prompts/USER.md

# Per-project custom prompts
prompts/projects/
